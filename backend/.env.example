# ============================================
# CineVault — переменные окружения (шаблон)
# ============================================
# Скопируй этот файл в .env и заполни реальными значениями:
#   cp .env.example .env

# --- Сервер ---
PORT=3001
DB_PATH=./cinevault.db
NODE_ENV=development

# --- JWT ---
# Секретный ключ для подписи токенов.
# Замени на случайную строку 32+ символов.
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change_me_to_a_random_long_string_in_production
JWT_EXPIRES_IN=7d

# --- URL ---
# FRONTEND_URL используется для ссылки в письме подтверждения email
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:3001

# --- Gmail SMTP ---
# EMAIL_USER — твой Gmail-адрес
# EMAIL_PASS — 16-значный App Password (без пробелов)
# Получить: https://myaccount.google.com/apppasswords
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_16_char_app_password
EMAIL_FROM=CineVault <your_email@gmail.com>

# --- TMDB API ---
# Получить: https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here